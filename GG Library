-- [[ GG LIBRARY V5 - EXPANDED PRO EDITION ]] --
-- Features: Elastic UI, Real Ripple, Neon Sliders, Pro Tabs
-- Theme: Original Dark Blue & Neon Red

local CyberLib = {}
local UIS = game:GetService("UserInputService")
local CoreGui = game:GetService("CoreGui")
local TS = game:GetService("TweenService")
local Player = game.Players.LocalPlayer
local Mouse = Player:GetMouse()

-- [[ ADVANCED TWEEN ENGINE ]] --
local function Ani(obj, time, prop, style, dir)
    local info = TweenInfo.new(time, style or Enum.EasingStyle.Quart, dir or Enum.EasingDirection.Out)
    local tween = TS:Create(obj, info, prop)
    tween:Play()
    return tween
end

-- [[ NOTIFICATION SYSTEM ]] --
function CyberLib:Notification(title, text, duration)
    local NotifGui = Instance.new("ScreenGui", CoreGui)
    local Frame = Instance.new("Frame", NotifGui)
    Frame.Size = UDim2.new(0, 220, 0, 65)
    Frame.Position = UDim2.new(1, 30, 0.8, 0)
    Frame.BackgroundColor3 = Color3.fromRGB(10, 10, 25)
    Instance.new("UICorner", Frame).CornerRadius = UDim.new(0, 10)
    local S = Instance.new("UIStroke", Frame)
    S.Color = Color3.fromRGB(255, 0, 60); S.Thickness = 2

    local T = Instance.new("TextLabel", Frame)
    T.Text = " " .. title; T.Size = UDim2.new(1, 0, 0, 25); T.TextColor3 = Color3.new(0, 1, 1); T.BackgroundTransparency = 1; T.Font = "GothamBold"; T.TextXAlignment = "Left"

    local D = Instance.new("TextLabel", Frame)
    D.Text = " " .. text; D.Size = UDim2.new(1, 0, 1, -25); D.Position = UDim2.new(0, 0, 0, 25); D.TextColor3 = Color3.new(1, 1, 1); D.BackgroundTransparency = 1; D.TextSize = 11; D.TextWrapped = true; D.TextXAlignment = "Left"; D.TextYAlignment = "Top"

    Ani(Frame, 0.5, {Position = UDim2.new(1, -230, 0.8, 0)})
    task.delay(duration or 3, function()
        Ani(Frame, 0.5, {Position = UDim2.new(1, 30, 0.8, 0)})
        task.wait(0.5); NotifGui:Destroy()
    end)
end

-- [[ MAIN WINDOW CREATION ]] --
function CyberLib:CreateWindow(hubName)
    -- Cleanup
    for _, v in pairs(CoreGui:GetChildren()) do
        if v.Name == "GGLib_Final" or v.Name == "GGTgl_Final" then v:Destroy() end
    end

    local MainGui = Instance.new("ScreenGui", CoreGui); MainGui.Name = "GGLib_Final"
    
    local MainFrame = Instance.new("Frame", MainGui)
    MainFrame.BackgroundColor3 = Color3.fromRGB(8, 8, 20)
    MainFrame.Position = UDim2.new(0.5, -120, 0.4, -90)
    MainFrame.Size = UDim2.new(0, 0, 0, 0) -- For Elastic Pop
    MainFrame.ClipsDescendants = true; MainFrame.Active = true; MainFrame.Draggable = true
    Instance.new("UICorner", MainFrame).CornerRadius = UDim.new(0, 15)
    local Stroke = Instance.new("UIStroke", MainFrame); Stroke.Thickness = 2.5; Stroke.Color = Color3.fromRGB(255, 0, 60)

    -- Elastic Entrance
    Ani(MainFrame, 0.8, {Size = UDim2.new(0, 240, 0, 190)}, Enum.EasingStyle.Elastic)

    -- Custom Image Toggle Button
    local TglGui = Instance.new("ScreenGui", CoreGui); TglGui.Name = "GGTgl_Final"
    local TglBtn = Instance.new("ImageButton", TglGui)
    TglBtn.Size = UDim2.new(0, 48, 0, 48); TglBtn.Position = UDim2.new(0, 15, 0.5, -24); TglBtn.BackgroundColor3 = Color3.fromRGB(10, 10, 30); TglBtn.Draggable = true
    TglBtn.Image = "https://www.roblox.com/asset-thumbnail/image?assetId=126880062074667&width=420&height=420&format=png"
    Instance.new("UICorner", TglBtn).CornerRadius = UDim.new(0, 12); Instance.new("UIStroke", TglBtn).Color = Color3.fromRGB(255, 0, 60)
    
    TglBtn.MouseButton1Click:Connect(function()
        if MainFrame.Visible then
            Ani(MainFrame, 0.4, {Size = UDim2.new(0, 0, 0, 0)}, Enum.EasingStyle.Back)
            task.wait(0.4); MainFrame.Visible = false
        else
            MainFrame.Visible = true; Ani(MainFrame, 0.5, {Size = UDim2.new(0, 240, 0, 190)}, Enum.EasingStyle.Elastic)
        end
    end)

    -- Header / Tab Bar
    local TabBar = Instance.new("Frame", MainFrame)
    TabBar.Size = UDim2.new(1, 0, 0, 32); TabBar.BackgroundColor3 = Color3.fromRGB(15, 15, 35)
    Instance.new("UICorner", TabBar).CornerRadius = UDim.new(0, 15)
    
    local X = Instance.new("TextButton", TabBar); X.Size = UDim2.new(0, 32, 1, 0); X.Position = UDim2.new(1, -32, 0, 0); X.Text = "X"; X.TextColor3 = Color3.new(1, 0, 0); X.BackgroundTransparency = 1; X.TextSize = 16
    X.MouseButton1Click:Connect(function() Ani(MainFrame, 0.4, {Size = UDim2.new(0, 0, 0, 0)}, Enum.EasingStyle.Back); task.wait(0.4); MainFrame.Visible = false end)

    local Pages = Instance.new("Frame", MainFrame)
    Pages.Size = UDim2.new(1, -10, 1, -70); Pages.Position = UDim2.new(0, 5, 0, 65); Pages.BackgroundTransparency = 1

    local TabScroll = Instance.new("ScrollingFrame", MainFrame)
    TabScroll.Size = UDim2.new(1, -10, 0, 28); TabScroll.Position = UDim2.new(0, 5, 0, 35); TabScroll.BackgroundTransparency = 1; TabScroll.ScrollBarThickness = 0; TabScroll.CanvasSize = UDim2.new(2, 0, 0, 0)
    local TList = Instance.new("UIListLayout", TabScroll); TList.FillDirection = "Horizontal"; TList.Padding = UDim.new(0, 5)

    local Window = {first = true}

    function Window:CreateTab(name)
        local Page = Instance.new("ScrollingFrame", Pages)
        Page.Size = UDim2.new(1, 0, 1, 0); Page.Visible = Window.first; Page.BackgroundTransparency = 1; Page.ScrollBarThickness = 0; Page.AutomaticCanvasSize = "Y"
        local PList = Instance.new("UIListLayout", Page); PList.Padding = UDim.new(0, 8); PList.HorizontalAlignment = "Center"; PList.SortOrder = "LayoutOrder"
        
        local TBtn = Instance.new("TextButton", TabScroll)
        TBtn.Size = UDim2.new(0, 65, 1, 0); TBtn.BackgroundColor3 = Window.first and Color3.fromRGB(255, 0, 60) or Color3.fromRGB(30, 30, 50)
        TBtn.Text = name; TBtn.TextColor3 = Color3.new(1, 1, 1); TBtn.Font = "GothamBold"; TBtn.TextSize = 10; Instance.new("UICorner", TBtn)
        
        TBtn.MouseButton1Click:Connect(function()
            for _, p in pairs(Pages:GetChildren()) do p.Visible = false end
            for _, t in pairs(TabScroll:GetChildren()) do if t:IsA("TextButton") then Ani(t, 0.3, {BackgroundColor3 = Color3.fromRGB(30, 30, 50)}) end end
            Page.Visible = true; Ani(TBtn, 0.3, {BackgroundColor3 = Color3.fromRGB(255, 0, 60)})
        end)
        
        Window.first = false
        local Elements = {}

        -- [[ BUTTON COMPONENT ]]
        function Elements:CreateButton(txt, cb)
            local b = Instance.new("TextButton", Page); b.Size = UDim2.new(1, -5, 0, 35); b.BackgroundColor3 = Color3.fromRGB(30, 30, 50); b.Text = txt; b.TextColor3 = Color3.new(1, 1, 1); b.Font = "GothamBold"; b.ClipsDescendants = true; Instance.new("UICorner", b)
            b.MouseButton1Click:Connect(function()
                -- Ripple Animation
                local c = Instance.new("Frame", b); c.BackgroundColor3 = Color3.new(1, 1, 1); c.BackgroundTransparency = 0.8; c.Position = UDim2.new(0, Mouse.X-b.AbsolutePosition.X, 0, Mouse.Y-b.AbsolutePosition.Y); Instance.new("UICorner", c).CornerRadius = UDim.new(1, 0)
                c:TweenSizeAndPosition(UDim2.new(0, 250, 0, 250), UDim2.new(0, Mouse.X-b.AbsolutePosition.X-125, 0, Mouse.Y-b.AbsolutePosition.Y-125), "Out", "Quart", 0.4)
                task.delay(0.4, function() c:Destroy() end); cb()
            end)
        end

        -- [[ TOGGLE COMPONENT ]]
        function Elements:CreateToggle(txt, cb)
            local t = Instance.new("TextButton", Page); t.Size = UDim2.new(1, -5, 0, 35); t.BackgroundColor3 = Color3.fromRGB(30, 30, 50); t.Text = "  "..txt; t.TextColor3 = Color3.new(1, 1, 1); t.TextXAlignment = "Left"; t.Font = "GothamBold"; Instance.new("UICorner", t)
            local ind = Instance.new("Frame", t); ind.Size = UDim2.new(0, 26, 0, 14); ind.Position = UDim2.new(1, -35, 0.5, -7); ind.BackgroundColor3 = Color3.fromRGB(80, 0, 0); Instance.new("UICorner", ind).CornerRadius = UDim.new(1, 0)
            local dot = Instance.new("Frame", ind); dot.Size = UDim2.new(0, 10, 0, 10); dot.Position = UDim2.new(0, 2, 0.5, -5); dot.BackgroundColor3 = Color3.new(1, 1, 1); Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)
            local s = false
            t.MouseButton1Click:Connect(function()
                s = not s; Ani(dot, 0.3, {Position = s and UDim2.new(1, -12, 0.5, -5) or UDim2.new(0, 2, 0.5, -5)}); Ani(ind, 0.3, {BackgroundColor3 = s and Color3.fromRGB(0, 255, 100) or Color3.fromRGB(80, 0, 0)})
                cb(s)
            end)
        end

        -- [[ SLIDER COMPONENT ]]
        function Elements:CreateSlider(txt, min, max, cb)
            local s = Instance.new("Frame", Page); s.Size = UDim2.new(1, -5, 0, 45); s.BackgroundColor3 = Color3.fromRGB(30, 30, 50); Instance.new("UICorner", s)
            local tl = Instance.new("TextLabel", s); tl.Text = "  "..txt; tl.Size = UDim2.new(1, 0, 0, 20); tl.TextColor3 = Color3.new(1, 1, 1); tl.BackgroundTransparency = 1; tl.TextXAlignment = "Left"; tl.Font = "GothamBold"
            local bar = Instance.new("Frame", s); bar.Size = UDim2.new(0.9, 0, 0, 4); bar.Position = UDim2.new(0.05, 0, 0.75, 0); bar.BackgroundColor3 = Color3.fromRGB(15, 15, 30); Instance.new("UICorner", bar)
            local fill = Instance.new("Frame", bar); fill.Size = UDim2.new(0, 0, 1, 0); fill.BackgroundColor3 = Color3.fromRGB(255, 0, 60); Instance.new("UICorner", fill)
            local vl = Instance.new("TextLabel", s); vl.Size = UDim2.new(1, -15, 0, 20); vl.BackgroundTransparency = 1; vl.Text = tostring(min); vl.TextColor3 = Color3.new(0, 1, 1); vl.TextXAlignment = "Right"
            local m = false
            local function up()
                local pos = math.clamp((UIS:GetMouseLocation().X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
                Ani(fill, 0.1, {Size = UDim2.new(pos, 0, 1, 0)}); local v = math.floor(min + (max - min) * pos); vl.Text = tostring(v); cb(v)
            end
            bar.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then m = true up() end end)
            UIS.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then m = false end end)
            UIS.InputChanged:Connect(function(i) if m and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then up() end end)
        end

        -- [[ TEXTBOX COMPONENT ]]
        function Elements:CreateTextBox(ph, cb)
            local b = Instance.new("TextBox", Page); b.Size = UDim2.new(1, -5, 0, 32); b.BackgroundColor3 = Color3.fromRGB(15, 15, 25); b.PlaceholderText = ph; b.Text = ""; b.TextColor3 = Color3.new(1, 1, 1); b.Font = "GothamMedium"; Instance.new("UICorner", b)
            local S = Instance.new("UIStroke", b); S.Color = Color3.fromRGB(0, 255, 255); S.Transparency = 0.7
            b.Focused:Connect(function() Ani(S, 0.3, {Transparency = 0, Thickness = 2}) end)
            b.FocusLost:Connect(function(e) Ani(S, 0.3, {Transparency = 0.7, Thickness = 1}) if e then cb(b.Text) end end)
        end

        function Elements:CreateLabel(txt)
            local l = Instance.new("TextLabel", Page); l.Size = UDim2.new(1, -5, 0, 30); l.BackgroundColor3 = Color3.fromRGB(20, 20, 35); l.Text = txt; l.TextColor3 = Color3.new(0, 1, .6); l.Font = "Code"; Instance.new("UICorner", l); return l
        end

        return Elements
    end

    function Window:Destroy()
        Ani(MainFrame, 0.4, {Size = UDim2.new(0, 0, 0, 0)}, Enum.EasingStyle.Back); task.wait(0.4)
        MainGui:Destroy(); TglGui:Destroy()
    end

    return Window
end

return CyberLib
