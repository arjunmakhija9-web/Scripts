-- [[ GG LIBRARY V3 - OFFICIAL MODULE ]] --
-- Theme: Cyberpunk (Dark Blue & Neon Red)
-- Features: Elastic Animations, Ripple Effects, Asset Fix

local CyberLib = {}

local UIS = game:GetService("UserInputService")
local CoreGui = game:GetService("CoreGui")
local TS = game:GetService("TweenService")
local Player = game.Players.LocalPlayer
local Mouse = Player:GetMouse()
local ContentProvider = game:GetService("ContentProvider")

-- Utility: Advanced Tween Engine
local function Ani(obj, time, prop, style)
    local style = style or Enum.EasingStyle.Quart
    local tween = TS:Create(obj, TweenInfo.new(time, style, Enum.EasingDirection.Out), prop)
    tween:Play()
    return tween
end

function CyberLib:CreateWindow(hubName)
    -- Cleanup of previous instances
    for _, v in pairs(CoreGui:GetChildren()) do
        if v.Name == "GGLib_Final" or v.Name == "GGToggle_Final" then
            v:Destroy()
        end
    end

    local MainGui = Instance.new("ScreenGui")
    MainGui.Name = "GGLib_Final"
    MainGui.Parent = CoreGui
    MainGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

    -- MAIN FRAME
    local MainFrame = Instance.new("Frame")
    MainFrame.Name = "MainFrame"
    MainFrame.Parent = MainGui
    MainFrame.BackgroundColor3 = Color3.fromRGB(5, 5, 12)
    MainFrame.Position = UDim2.new(0.5, -110, 0.4, -115)
    MainFrame.Size = UDim2.new(0, 0, 0, 0) -- Starts at 0 for Elastic Animation
    MainFrame.ClipsDescendants = true
    MainFrame.Active = true

    local MainCorner = Instance.new("UICorner", MainFrame)
    MainCorner.CornerRadius = UDim.new(0, 18)

    local MainStroke = Instance.new("UIStroke", MainFrame)
    MainStroke.Thickness = 3
    MainStroke.Color = Color3.fromRGB(255, 0, 60) -- Neon Red
    MainStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border

    -- TITLE BAR
    local Title = Instance.new("TextLabel")
    Title.Size = UDim2.new(1, 0, 0, 45)
    Title.BackgroundColor3 = Color3.fromRGB(12, 12, 28)
    Title.Text = "» " .. hubName .. " «"
    Title.TextColor3 = Color3.fromRGB(0, 255, 255) -- Cyan
    Title.Font = Enum.Font.RobotoMono
    Title.TextSize = 18
    Title.Parent = MainFrame
    Instance.new("UICorner", Title).CornerRadius = UDim.new(0, 18)

    -- Elastic Opening
    Ani(MainFrame, 0.8, {Size = UDim2.new(0, 220, 0, 260)}, Enum.EasingStyle.Elastic)

    -- DRAGGING
    local dragging, dragStart, startPos
    MainFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true; dragStart = input.Position; startPos = MainFrame.Position
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            Ani(MainFrame, 0.1, {Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)})
        end
    end)
    UIS.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end end)

    -- CONTAINER
    local Container = Instance.new("ScrollingFrame", MainFrame)
    Container.Position = UDim2.new(0, 10, 0, 52)
    Container.Size = UDim2.new(1, -20, 1, -65)
    Container.BackgroundTransparency = 1
    Container.ScrollBarThickness = 0
    Container.AutomaticCanvasSize = Enum.AutomaticSize.Y
    
    local Layout = Instance.new("UIListLayout", Container)
    Layout.Padding = UDim.new(0, 10)
    Layout.HorizontalAlignment = Enum.HorizontalAlignment.Center

    -- [[ FLOATING TOGGLE ICON - IMAGE FIXED ]]
    local ToggleGui = Instance.new("ScreenGui", CoreGui)
    ToggleGui.Name = "GGToggle_Final"
    
    local TglBtn = Instance.new("ImageButton", ToggleGui)
    TglBtn.Size = UDim2.new(0, 55, 0, 55)
    TglBtn.Position = UDim2.new(0, 20, 0.5, -27)
    TglBtn.BackgroundColor3 = Color3.fromRGB(8, 8, 20)
    
    -- IMAGE FIX: Direct Thumbnail Link for 100% Load
    local imgID = "126880062074667"
    TglBtn.Image = "https://www.roblox.com/asset-thumbnail/image?assetId=" .. imgID .. "&width=420&height=420&format=png"
    
    TglBtn.Draggable = true
    Instance.new("UICorner", TglBtn).CornerRadius = UDim.new(0, 15)
    local TS_Stroke = Instance.new("UIStroke", TglBtn)
    TS_Stroke.Thickness = 2.5
    TS_Stroke.Color = Color3.fromRGB(255, 0, 60)

    TglBtn.MouseButton1Click:Connect(function()
        if MainFrame.Visible then
            Ani(MainFrame, 0.4, {Size = UDim2.new(0, 0, 0, 0)}, Enum.EasingStyle.Back)
            task.wait(0.4)
            MainFrame.Visible = false
        else
            MainFrame.Visible = true
            Ani(MainFrame, 0.5, {Size = UDim2.new(0, 220, 0, 260)}, Enum.EasingStyle.Elastic)
        end
    end)

    -- [[ MODULE OBJECT ]]
    local Window = {}

    -- 1. BUTTON (With Ripple)
    function Window:CreateButton(text, callback)
        local Btn = Instance.new("TextButton", Container)
        Btn.Size = UDim2.new(1, 0, 0, 40)
        Btn.BackgroundColor3 = Color3.fromRGB(20, 20, 40)
        Btn.Text = "» " .. text
        Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        Btn.Font = Enum.Font.GothamBold
        Btn.TextSize = 13
        Btn.ClipsDescendants = true
        Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 10)
        
        local BStroke = Instance.new("UIStroke", Btn)
        BStroke.Color = Color3.fromRGB(255, 0, 60)
        BStroke.Transparency = 0.6

        Btn.MouseButton1Click:Connect(function()
            -- Ripple Effect
            local Circle = Instance.new("Frame", Btn)
            Circle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            Circle.BackgroundTransparency = 0.8
            Circle.Position = UDim2.new(0, Mouse.X - Btn.AbsolutePosition.X, 0, Mouse.Y - Btn.AbsolutePosition.Y)
            Instance.new("UICorner", Circle).CornerRadius = UDim.new(1, 0)
            Circle:TweenSizeAndPosition(UDim2.new(0, 250, 0, 250), UDim2.new(0, Mouse.X - Btn.AbsolutePosition.X - 125, 0, Mouse.Y - Btn.AbsolutePosition.Y - 125), "Out", "Quart", 0.4)
            Ani(Circle, 0.4, {BackgroundTransparency = 1})
            delay(0.4, function() Circle:Destroy() end)
            
            callback()
        end)
    end

    -- 2. TOGGLE
    function Window:CreateToggle(text, callback)
        local Tgl = Instance.new("TextButton", Container)
        Tgl.Size = UDim2.new(1, 0, 0, 40)
        Tgl.BackgroundColor3 = Color3.fromRGB(20, 20, 40)
        Tgl.Text = "   " .. text
        Tgl.TextColor3 = Color3.fromRGB(255, 255, 255)
        Tgl.TextXAlignment = Enum.TextXAlignment.Left
        Tgl.Font = Enum.Font.GothamMedium
        Instance.new("UICorner", Tgl).CornerRadius = UDim.new(0, 10)

        local Track = Instance.new("Frame", Tgl)
        Track.Size = UDim2.new(0, 36, 0, 18)
        Track.Position = UDim2.new(1, -48, 0.5, -9)
        Track.BackgroundColor3 = Color3.fromRGB(40, 40, 60)
        Instance.new("UICorner", Track).CornerRadius = UDim.new(1, 0)

        local Knob = Instance.new("Frame", Track)
        Knob.Size = UDim2.new(0, 14, 0, 14)
        Knob.Position = UDim2.new(0, 2, 0.5, -7)
        Knob.BackgroundColor3 = Color3.fromRGB(200, 200, 200)
        Instance.new("UICorner", Knob).CornerRadius = UDim.new(1, 0)

        local state = false
        Tgl.MouseButton1Click:Connect(function()
            state = not state
            Ani(Knob, 0.3, {Position = state and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)})
            Ani(Track, 0.3, {BackgroundColor3 = state and Color3.fromRGB(255, 0, 60) or Color3.fromRGB(40, 40, 60)})
            callback(state)
        end)
    end

    -- 3. TEXTBOX
    function Window:CreateTextBox(placeholder, callback)
        local Box = Instance.new("TextBox", Container)
        Box.Size = UDim2.new(1, 0, 0, 40)
        Box.BackgroundColor3 = Color3.fromRGB(12, 12, 28)
        Box.PlaceholderText = placeholder
        Box.Text = ""
        Box.TextColor3 = Color3.fromRGB(0, 255, 255)
        Box.Font = Enum.Font.Code
        Instance.new("UICorner", Box).CornerRadius = UDim.new(0, 10)
        
        local S = Instance.new("UIStroke", Box)
        S.Color = Color3.fromRGB(0, 255, 255)
        S.Transparency = 0.7
        
        Box.FocusLost:Connect(function(enter) if enter then callback(Box.Text) end end)
    end

    -- 4. DESTROY
    function Window:Destroy()
        Ani(MainFrame, 0.4, {Size = UDim2.new(0, 0, 0, 0)}, Enum.EasingStyle.Back)
        task.wait(0.4)
        MainGui:Destroy()
        ToggleGui:Destroy()
    end

    return Window
end

return CyberLib
