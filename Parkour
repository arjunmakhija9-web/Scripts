local function CreatePart(cf, size, color, mat)
    local p = Instance.new("Part")
    p.CFrame = cf
    p.Size = size
    p.BrickColor = BrickColor.new(color)
    p.Material = mat or Enum.Material.SmoothPlastic
    p.Anchored = true
    p.Parent = MapFolder
    return p
end

local isRespawning = false
local function AddKill(part)
    part.Touched:Connect(function(hit)
        local char = hit.Parent
        if char.Name == LocalPlayer.Name and not isRespawning then
            if not _G.GodMode then
                isRespawning = true
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    -- Respawn instantly, facing the correct direction!
                    hrp.CFrame = _G.LastCheckpointCFrame * CFrame.new(0, 4, 0)
                end
                task.wait(0.1)
                isRespawning = false
            end
        end
    end)
end

