local function AddShopItem(name, cost, posY, color, func)
    local btn = Instance.new("TextButton", ShopFrame)
    btn.Size = UDim2.new(0.9, 0, 0, 50)
    btn.Position = UDim2.new(0.05, 0, posY, 0)
    btn.Text = name .. " (" .. cost .. " Wins)"
    btn.BackgroundColor3 = color
    btn.TextColor3 = Color3.new(1, 1, 1)
    btn.Font = Enum.Font.GothamBold
    Instance.new("UICorner", btn)
    
    btn.MouseButton1Click:Connect(function()
        if _G.Wins >= cost then
            _G.Wins -= cost
            WinLabel.Text = "WINS: " .. _G.Wins
            func()
            btn.Text = "APPLIED!"
            task.wait(1)
            btn.Text = name .. " (" .. cost .. " Wins)"
        end
    end)
end

