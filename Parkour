-- 5. PARKOUR ENGINE (PERFECT SPACING)
-----------------------------------------------------------
local CursorCF = LobbyCF * CFrame.new(0, 0, 20) -- Start at the edge of the lobby
local void = CreatePart(CFrame.new(0, 0, 0), Vector3.new(100000, 10, 100000), "Really black", Enum.Material.Neon)
AddKill(void)

local Generators = {
    function(cf) -- Normal Jump (Easy)
        CreatePart(cf * CFrame.new(0, 0, 6), Vector3.new(8, 1, 8), "White")
        return cf * CFrame.new(0, 0, 12)
    end,
    function(cf) -- Lava Strip (Fair size)
        CreatePart(cf * CFrame.new(0, 0, 6), Vector3.new(12, 1, 12), "White")
        local l = CreatePart(cf * CFrame.new(0, 0.6, 6), Vector3.new(12, 0.2, 3), "Bright red", Enum.Material.Neon)
        AddKill(l)
        return cf * CFrame.new(0, 0, 12)
    end,
    function(cf) -- Thin Beam
        CreatePart(cf * CFrame.new(0, 0, 8), Vector3.new(2, 1, 16), "Cyan")
        return cf * CFrame.new(0, 0, 16)
    end,
    function(cf) -- Glass Steps (Close together)
        for i=1, 3 do
            local g = CreatePart(cf * CFrame.new(0, 0, i*6), Vector3.new(4, 0.5, 4), "Cyan", Enum.Material.Glass)
            g.Touched:Connect(function() task.wait(0.2) g.CanCollide = false g.Transparency = 1 task.wait(2) g.CanCollide = true g.Transparency = 0 end)
        end
        return cf * CFrame.new(0, 0, 20)
    end,
    function(cf) -- Spinner (Safe gap)
        CreatePart(cf * CFrame.new(0, 0, 6), Vector3.new(10, 1, 10), "Black")
        local bar = CreatePart(cf * CFrame.new(0, 2, 6), Vector3.new(14, 1, 1), "Bright red", Enum.Material.Neon)
        AddKill(bar)
        spawn(function() while bar.Parent do bar.CFrame *= CFrame.Angles(0, 0.05, 0) task.wait() end end)
        return cf * CFrame.new(0, 0, 12)
    end
}

print("GENERATING BALANCED OBBY...")

local TotalStages = 50 -- 50 Stages
local JumpsPerStage = 5 -- 5 Jumps per stage = 250 Total Obstacles

for stage = 1, TotalStages do
    
    -- 1. Generate 5 normal obstacles
    for jump = 1, JumpsPerStage do
        local gen = Generators[math.random(1, #Generators)]
        CursorCF = gen(CursorCF)
    end
    
    -- 2. Create the Checkpoint for this Stage
    local cpSize = Vector3.new(16, 1, 16)
    -- Place it 8 studs away from the last obstacle
    local cp = CreatePart(CursorCF * CFrame.new(0, 0, 8), cpSize, "Neon orange", Enum.Material.Neon)
    
    -- When touched, update the Stage and Save the CFrame
    cp.Touched:Connect(function(hit)
        if hit.Parent.Name == LocalPlayer.Name and _G.CurrentStageNumber < stage then
            _G.CurrentStageNumber = stage
            StageLabel.Text = "STAGE: " .. stage
            _G.LastCheckpointCFrame = cp.CFrame -- Saves direction!
            cp.BrickColor = BrickColor.new("Lime green")
        end
    end)
    
    -- Move cursor to the middle of the Checkpoint
    CursorCF = CursorCF * CFrame.new(0, 0, 8)
    
    -- 3. Check if we need to make a turn (Every 3 Stages = Every 15 Jumps)
    if stage % 3 == 0 then
        -- Pick left or right randomly
        local turnAngle = (math.random() > 0.5) and 90 or -90
        CursorCF = CursorCF * CFrame.Angles(0, math.rad(turnAngle), 0)
    else
        -- Add a tiny random upward slope if going straight
        CursorCF = CursorCF * CFrame.new(0, math.random(0, 1), 0)
    end
    
    -- Move cursor to the edge of the Checkpoint so the next jump doesn't clip into it
    CursorCF = CursorCF * CFrame.new(0, 0, 8)
    
    task.wait() -- Prevent lag during generation
end

